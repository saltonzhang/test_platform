# Copy this file to .env.production on the server and replace every password.
MYSQL_DATABASE=test_aibetauto
MYSQL_USER=aibet
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=mail4.space,www.mail4.space
CORS_ALLOWED_ORIGINS=https://mail4.space,https://www.mail4.space
# Optional: leave empty unless Feishu alarm notifications are required.
FEISHU_BOT_WEBHOOK_URL=
FEISHU_BOT_SSL_VERIFY=true

# Data factory target database. Keep actual values only in .env.production.
DATA_FACTORY_DB_HOST=
DATA_FACTORY_DB_PORT=3306
DATA_FACTORY_DB_USER=
DATA_FACTORY_DB_PASSWORD=
DATA_FACTORY_DB_NAME=
DATA_FACTORY_DB_CHARSET=utf8mb4
DATA_FACTORY_DB_CONNECT_TIMEOUT=10
DATA_FACTORY_DB_READ_TIMEOUT=30
DATA_FACTORY_DB_WRITE_TIMEOUT=30
